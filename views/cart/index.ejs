<div class="container py-4 py-md-5">
  <div class="mb-4">
    <h2 class="fw-bold mb-1">Your Shopping Bag</h2>
    <p class="text-muted small">Review your pieces before proceeding to checkout</p>
  </div>

  <% if (!cart || cart.length === 0) { %>
    <div class="text-center py-5 bg-white rounded-4 shadow-sm p-4 my-4">
      <div class="mb-3 text-muted">
        <i class="bi bi-bag-x fs-1"></i>
      </div>
      <h4>Your shopping bag is empty</h4>
      <p class="text-muted mb-4">Discover our new arrivals and timeless silhouettes.</p>
      <a href="/shop" class="btn btn-primary-gold rounded-pill px-4 py-2">
        Start Shopping <i class="bi bi-arrow-right ms-1"></i>
      </a>
    </div>
  <% } else { %>
    <!-- Free Shipping Indicator -->
    <% const freeShippingThreshold = 1999; %>
    <% const remainingForFree = Math.max(0, freeShippingThreshold - itemsTotal); %>
    <% const progressPct = Math.min(100, Math.round((itemsTotal / freeShippingThreshold) * 100)); %>

    <div class="card border-0 shadow-sm p-3 mb-4 rounded-4 bg-light">
      <div class="d-flex justify-content-between align-items-center mb-2 small">
        <% if (remainingForFree > 0) { %>
          <span>Add <strong>₹<%= remainingForFree.toLocaleString('en-IN') %></strong> more to unlock <strong class="text-success">FREE Delivery</strong>!</span>
        <% } else { %>
          <span class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i> You have unlocked FREE Express Delivery!</span>
        <% } %>
        <span class="fw-bold"><%= progressPct %>%</span>
      </div>
      <div class="progress" style="height: 6px;">
        <div class="progress-bar bg-success" role="progressbar" style="width: <%= progressPct %>%;"></div>
      </div>
    </div>

    <div class="row g-4">
      <!-- Items List -->
      <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
          <div class="card-body p-0">
            <% cart.forEach((item, i) => { %>
              <div class="p-3 p-md-4 <%= i > 0 ? 'border-top' : '' %> d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
                <!-- Product Info & Thumb -->
                <div class="d-flex align-items-center gap-3">
                  <img src="<%= item.image || '/images/placeholder.png' %>" class="rounded-3 shadow-sm" style="width: 72px; height: 90px; object-fit: cover;" alt="<%= item.name %>">
                  <div>
                    <h6 class="mb-1">
                      <a href="/product/<%= item.slug %>" class="text-dark text-decoration-none fw-semibold"><%= item.name %></a>
                    </h6>
                    <div class="small text-muted mb-1">
                      <span>Size: <strong><%= item.size %></strong></span>
                      <% if (item.color) { %>
                        <span class="ms-2">Color: <strong><%= item.color %></strong></span>
                      <% } %>
                    </div>
                    <div class="fw-bold text-dark">
                      ₹<%= item.price.toLocaleString('en-IN') %>
                    </div>
                  </div>
                </div>

                <!-- Quantity & Actions -->
                <div class="d-flex align-items-center justify-content-between justify-content-sm-end gap-3 mt-2 mt-sm-0">
                  <form action="/cart/update/<%= i %>" method="POST" class="d-flex align-items-center">
                    <div class="input-group input-group-sm" style="width: 100px;">
                      <button class="btn btn-outline-secondary" type="button" onclick="this.nextElementSibling.stepDown(); this.form.submit();">-</button>
                      <input type="number" name="quantity" value="<%= item.quantity %>" min="1" class="form-control text-center fw-bold" onchange="this.form.submit()">
                      <button class="btn btn-outline-secondary" type="button" onclick="this.previousElementSibling.stepUp(); this.form.submit();">+</button>
                    </div>
                  </form>

                  <div class="fw-bold text-dark text-end" style="min-width: 90px;">
                    ₹<%= (item.price * item.quantity).toLocaleString('en-IN') %>
                  </div>

                  <form action="/cart/remove/<%= i %>" method="POST">
                    <button type="submit" class="btn btn-sm btn-light text-danger rounded-circle p-2" title="Remove Item">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </div>

      <!-- Order Summary Card -->
      <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 85px;">
          <h5 class="fw-bold text-dark mb-3">Order Summary</h5>

          <div class="d-flex justify-content-between mb-2">
            <span class="text-secondary">Bag Subtotal</span>
            <span class="fw-bold text-dark">₹<%= itemsTotal.toLocaleString('en-IN') %></span>
          </div>

          <div class="d-flex justify-content-between mb-2">
            <span class="text-secondary">Estimated Delivery</span>
            <span><%= itemsTotal >= 1999 ? '<span class="text-success fw-bold">FREE</span>' : '₹99' %></span>
          </div>

          <hr class="my-3">

          <div class="d-flex justify-content-between align-items-baseline mb-4">
            <span class="fs-5 fw-bold text-dark">Estimated Total</span>
            <span class="fs-4 fw-bold text-dark">₹<%= (itemsTotal + (itemsTotal >= 1999 ? 0 : 99)).toLocaleString('en-IN') %></span>
          </div>

          <a href="/orders/checkout" class="btn btn-primary-gold btn-lg rounded-pill w-100 fw-bold py-3 shadow-sm d-flex align-items-center justify-content-center gap-2">
            Proceed to Checkout <i class="bi bi-arrow-right"></i>
          </a>

          <div class="text-center mt-3">
            <a href="/shop" class="small text-muted text-decoration-none">
              <i class="bi bi-arrow-left me-1"></i> Continue Shopping
            </a>
          </div>

          <div class="mt-4 pt-3 border-top small text-muted text-center">
            <i class="bi bi-shield-lock-fill text-success me-1"></i> 256-bit Encrypted Secure Checkout
          </div>
        </div>
      </div>
    </div>
  <% } %>
</div>
