<div class="container py-4 py-md-5">
  <div class="mb-4">
    <h2 class="fw-bold mb-1">My Orders & Purchases</h2>
    <p class="text-muted small">Track deliveries and review past garment purchases</p>
  </div>

  <% if (orders.length === 0) { %>
    <div class="text-center py-5 bg-white rounded-4 shadow-sm p-4 my-4">
      <i class="bi bi-box2 text-muted fs-1 d-block mb-3"></i>
      <h4>You haven't placed any orders yet</h4>
      <p class="text-muted mb-4">Explore our curated collections and start building your signature wardrobe.</p>
      <a href="/shop" class="btn btn-primary-gold rounded-pill px-4">Browse Collection</a>
    </div>
  <% } else { %>
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-3">Order ID</th>
              <th>Placed On</th>
              <th>Items Included</th>
              <th>Grand Total</th>
              <th>Fulfillment Status</th>
              <th class="text-end pe-3">Action</th>
            </tr>
          </thead>
          <tbody>
            <% orders.forEach(o => { %>
              <tr>
                <td class="ps-3 fw-bold font-monospace text-primary">
                  #<%= o._id.toString().slice(-6).toUpperCase() %>
                </td>
                <td class="small text-muted">
                  <%= new Date(o.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                </td>
                <td>
                  <span class="badge bg-light text-dark border">
                    <%= o.items.reduce((acc, i) => acc + i.quantity, 0) %> item(s)
                  </span>
                </td>
                <td class="fw-bold text-dark">
                  ₹<%= o.grandTotal.toLocaleString('en-IN') %>
                </td>
                <td>
                  <% let badgeClass = 'bg-secondary';
                     if (o.status === 'Placed') badgeClass = 'bg-warning text-dark';
                     else if (o.status === 'Processing') badgeClass = 'bg-info text-dark';
                     else if (o.status === 'Shipped') badgeClass = 'bg-primary text-white';
                     else if (o.status === 'Delivered') badgeClass = 'bg-success text-white';
                     else if (o.status === 'Cancelled') badgeClass = 'bg-danger text-white';
                  %>
                  <span class="badge <%= badgeClass %> rounded-pill px-3 py-1"><%= o.status %></span>
                </td>
                <td class="text-end pe-3">
                  <a href="/orders/confirmation/<%= o._id %>" class="btn btn-sm btn-outline-dark rounded-pill">
                    View Receipt
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
</div>
