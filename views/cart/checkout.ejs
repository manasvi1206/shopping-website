<div class="container py-4 py-md-5">
  <div class="mb-4">
    <h2 class="fw-bold mb-1">Checkout & Delivery Details</h2>
    <p class="text-muted small">Enter your delivery address to complete your order</p>
  </div>

  <div class="row g-4 g-lg-5">
    <!-- Shipping Form -->
    <div class="col-12 col-lg-7">
      <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <h5 class="fw-bold text-dark mb-3"><i class="bi bi-geo-alt me-2 text-gold"></i> Shipping Destination</h5>
        
        <form action="/orders/checkout" method="POST">
          <div class="mb-3">
            <label class="form-label fw-semibold">Street Address / Apartment <span class="text-danger">*</span></label>
            <input type="text" name="line1" class="form-control" placeholder="House/Flat number, Street name, Locality" required>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label fw-semibold">City <span class="text-danger">*</span></label>
              <input type="text" name="city" class="form-control" placeholder="Bengaluru / Mumbai" required>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">State <span class="text-danger">*</span></label>
              <input type="text" name="state" class="form-control" placeholder="Karnataka / Maharashtra" required>
            </div>
          </div>

          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label class="form-label fw-semibold">Postal PIN Code <span class="text-danger">*</span></label>
              <input type="text" name="pincode" class="form-control" placeholder="560001" required>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Contact Mobile Number <span class="text-danger">*</span></label>
              <input type="tel" name="phone" class="form-control" placeholder="+91 98765 43210" required>
            </div>
          </div>

          <div class="card border-0 bg-light p-3 rounded-3 mb-4">
            <div class="d-flex align-items-center justify-content-between">
              <div>
                <span class="fw-bold text-dark d-block">Cash on Delivery (COD)</span>
                <small class="text-muted">Pay securely in cash or via UPI upon package arrival at doorstep.</small>
              </div>
              <span class="badge bg-success">Default</span>
            </div>
          </div>

          <button type="submit" class="btn btn-primary-gold btn-lg w-100 rounded-pill fw-bold py-3 shadow-sm d-flex align-items-center justify-content-center gap-2">
            <i class="bi bi-check2-circle"></i> Place Order Now (₹<%= grandTotal.toLocaleString('en-IN') %>)
          </button>
        </form>
      </div>
    </div>

    <!-- Order Items Summary -->
    <div class="col-12 col-lg-5">
      <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 85px;">
        <h5 class="fw-bold text-dark mb-3">Order Items (<%= cart.length %>)</h5>

        <div class="d-flex flex-column gap-3 mb-4 max-vh-50 overflow-auto">
          <% cart.forEach(item => { %>
            <div class="d-flex align-items-center gap-3">
              <img src="<%= item.image || '/images/placeholder.png' %>" class="rounded border" style="width: 52px; height: 64px; object-fit: cover;" alt="Item">
              <div class="flex-grow-1">
                <div class="fw-semibold small text-dark"><%= item.name %></div>
                <div class="text-muted" style="font-size: 0.75rem;"><%= item.size %> <%= item.color ? '• ' + item.color : '' %> × <%= item.quantity %></div>
              </div>
              <div class="fw-bold small text-dark">
                ₹<%= (item.price * item.quantity).toLocaleString('en-IN') %>
              </div>
            </div>
          <% }) %>
        </div>

        <div class="border-top pt-3">
          <div class="d-flex justify-content-between mb-2 small text-secondary">
            <span>Bag Subtotal</span>
            <span>₹<%= itemsTotal.toLocaleString('en-IN') %></span>
          </div>
          <div class="d-flex justify-content-between mb-2 small text-secondary">
            <span>Shipping Fee</span>
            <span><%= shippingFee === 0 ? '<strong class="text-success">FREE</strong>' : '₹' + shippingFee %></span>
          </div>
          <div class="d-flex justify-content-between fw-bold fs-5 text-dark mt-3 pt-2 border-top">
            <span>Total Payable</span>
            <span>₹<%= grandTotal.toLocaleString('en-IN') %></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
