<div class="container py-4 py-md-5">
  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb small text-muted">
      <li class="breadcrumb-item"><a href="/" class="text-muted text-decoration-none">Home</a></li>
      <li class="breadcrumb-item"><a href="/shop" class="text-muted text-decoration-none">Shop</a></li>
      <li class="breadcrumb-item"><a href="/shop?category=<%= product.category.slug %>" class="text-muted text-decoration-none"><%= product.category.name %></a></li>
      <li class="breadcrumb-item active text-dark" aria-current="page"><%= product.name %></li>
    </ol>
  </nav>

  <div class="row g-4 g-lg-5">
    <!-- Left Column: Gallery & Imagery -->
    <div class="col-12 col-lg-6">
      <div class="position-relative">
        <img id="mainProductImage"
             src="<%= product.images && product.images[0] ? product.images[0] : '/images/placeholder.png' %>"
             class="product-main-image"
             alt="<%= product.name %>">
        
        <% if (product.salePrice && product.price > product.salePrice) { %>
          <% const pct = Math.round(((product.price - product.salePrice) / product.price) * 100); %>
          <span class="product-badge-sale fs-6 px-3 py-1">-<%= pct %>% OFF</span>
        <% } %>
      </div>

      <!-- Gallery Thumbnails Switcher -->
      <% if (product.images && product.images.length > 1) { %>
        <div class="d-flex gap-2 mt-3 overflow-auto pb-2">
          <% product.images.forEach((img, idx) => { %>
            <img src="<%= img %>"
                 class="detail-thumb <%= idx === 0 ? 'active' : '' %>"
                 alt="Thumbnail <%= idx + 1 %>"
                 onclick="switchProductImage('<%= img %>', this)">
          <% }) %>
        </div>
      <% } %>
    </div>

    <!-- Right Column: Purchasing & Details -->
    <div class="col-12 col-lg-6">
      <div class="ps-lg-2">
        <span class="badge bg-gold-subtle text-gold text-uppercase tracking-wider mb-2 px-3 py-1 rounded-pill">
          <%= product.category.name %>
        </span>
        <h1 class="display-6 fw-bold text-dark mb-2"><%= product.name %></h1>

        <!-- Rating & Reviews -->
        <div class="d-flex align-items-center gap-2 mb-3">
          <div class="text-warning small">
            <i class="bi bi-star-fill"></i>
            <i class="bi bi-star-fill"></i>
            <i class="bi bi-star-fill"></i>
            <i class="bi bi-star-fill"></i>
            <i class="bi bi-star-fill"></i>
          </div>
          <span class="text-dark small fw-semibold">4.9</span>
          <span class="text-muted small">• 28 Verified Buyer Reviews</span>
        </div>

        <!-- Pricing Block -->
        <div class="p-3 bg-light rounded-4 mb-4 d-inline-flex align-items-baseline gap-3">
          <% if (product.salePrice) { %>
            <span class="fs-3 fw-bold text-dark">₹<%= product.salePrice.toLocaleString('en-IN') %></span>
            <span class="text-muted text-decoration-line-through fs-5">₹<%= product.price.toLocaleString('en-IN') %></span>
            <span class="badge bg-dark rounded-pill">Special Offer</span>
          <% } else { %>
            <span class="fs-3 fw-bold text-dark">₹<%= product.price.toLocaleString('en-IN') %></span>
          <% } %>
          <small class="text-muted">Inclusive of all taxes</small>
        </div>

        <p class="text-secondary leading-relaxed mb-4" style="font-size: 1.05rem;">
          <%= product.description %>
        </p>

        <!-- Add to Cart Form -->
        <form action="/cart/add/<%= product._id %>" method="POST" class="mb-4">
          <!-- Size Selector Pills -->
          <% if (product.sizes && product.sizes.length) { %>
            <div class="mb-4">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <label class="form-label fw-bold small text-uppercase tracking-wider text-dark mb-0">Select Size</label>
                <% if (product.sizeChart && product.sizeChart.length) { %>
                  <button type="button" class="btn btn-sm btn-link text-dark p-0 text-decoration-none fw-semibold" data-bs-toggle="modal" data-bs-target="#sizeChartModal">
                    <i class="bi bi-rulers me-1"></i> Size Chart
                  </button>
                <% } %>
              </div>
              <div class="d-flex flex-wrap gap-2">
                <% product.sizes.forEach((s, idx) => { %>
                  <div class="size-pill-radio">
                    <input type="radio" name="size" value="<%= s %>" id="detail-size-<%= s %>" <%= idx === 0 ? 'checked' : '' %> required>
                    <label class="size-pill-label" for="detail-size-<%= s %>"><%= s %></label>
                  </div>
                <% }) %>
              </div>
            </div>
          <% } %>

          <!-- Color Selector -->
          <% if (product.colors && product.colors.length) { %>
            <div class="mb-4">
              <label class="form-label fw-bold small text-uppercase tracking-wider text-dark mb-2">Color Choice</label>
              <div class="d-flex flex-wrap gap-2">
                <% product.colors.forEach((c, idx) => { %>
                  <div class="form-check form-check-inline border rounded-pill px-3 py-1 bg-white mb-0">
                    <input class="form-check-input" type="radio" name="color" id="detail-color-<%= c %>" value="<%= c %>" <%= idx === 0 ? 'checked' : '' %>>
                    <label class="form-check-label small fw-medium" for="detail-color-<%= c %>"><%= c %></label>
                  </div>
                <% }) %>
              </div>
            </div>
          <% } %>

          <!-- Quantity Stepper & Add Button -->
          <div class="row g-2 align-items-center">
            <div class="col-4 col-sm-3">
              <div class="input-group">
                <button class="btn btn-outline-secondary" type="button" onclick="adjustQty(-1)">-</button>
                <input type="number" id="qtyInput" name="quantity" value="1" min="1" max="<%= product.stock || 99 %>" class="form-control text-center fw-bold">
                <button class="btn btn-outline-secondary" type="button" onclick="adjustQty(1)">+</button>
              </div>
            </div>
            <div class="col-8 col-sm-9">
              <button type="submit" class="btn btn-primary-gold btn-lg w-100 rounded-pill fw-bold py-3 shadow-sm d-flex align-items-center justify-content-center gap-2">
                <i class="bi bi-bag-plus"></i> Add to Shopping Bag
              </button>
            </div>
          </div>
        </form>

        <!-- Value Guarantees -->
        <div class="card border-0 bg-light p-3 rounded-4 mb-4">
          <div class="d-flex flex-column gap-2 small text-secondary">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-shield-check text-success fs-5"></i>
              <span>Complimentary express delivery on orders over ₹1,999.</span>
            </div>
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-arrow-repeat text-dark fs-5"></i>
              <span>7-day door-step return & size exchange guarantee.</span>
            </div>
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-box-seam text-dark fs-5"></i>
              <span>Ships within 24 hours in signature Aurelle gift box.</span>
            </div>
          </div>
        </div>

        <!-- Specifications Accordion -->
        <% if (product.specs && Object.values(product.specs).some(v => v)) { %>
          <div class="accordion border-0 shadow-sm rounded-4 overflow-hidden" id="specsAccordion">
            <div class="accordion-item border-0">
              <h2 class="accordion-header">
                <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#specDetails">
                  <i class="bi bi-card-checklist me-2"></i> Garment Specifications & Care
                </button>
              </h2>
              <div id="specDetails" class="accordion-collapse collapse" data-bs-parent="#specsAccordion">
                <div class="accordion-body bg-light">
                  <div class="row row-cols-2 g-3 small">
                    <% const specLabels = { fabric: 'Fabric', fit: 'Fit Profile', occasion: 'Occasion', washCare: 'Wash Care', neck: 'Neckline', sleeveLength: 'Sleeve Length', sleeveType: 'Sleeve Type', pattern: 'Pattern' }; %>
                    <% Object.entries(specLabels).forEach(([key, label]) => { %>
                      <% if (product.specs[key]) { %>
                        <div class="col">
                          <span class="text-muted d-block" style="font-size:0.75rem;"><%= label %></span>
                          <span class="fw-semibold text-dark"><%= product.specs[key] %></span>
                        </div>
                      <% } %>
                    <% }) %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Related Products -->
  <% if (related && related.length) { %>
    <section class="mt-5 pt-4 border-top">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-dark mb-0">Complete the Look</h3>
        <a href="/shop?category=<%= product.category.slug %>" class="btn btn-sm btn-outline-dark rounded-pill px-3">
          Explore <%= product.category.name %>
        </a>
      </div>
      <div class="row g-4">
        <% related.forEach(p => { %>
          <div class="col-6 col-md-3">
            <%- include('../partials/product-card', { p }) %>
          </div>
        <% }) %>
      </div>
    </section>
  <% } %>
</div>

<!-- Size Chart Modal -->
<% if (product.sizeChart && product.sizeChart.length) { %>
  <div class="modal fade" id="sizeChartModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow-lg rounded-4">
        <div class="modal-header border-bottom">
          <h5 class="modal-title fw-bold">Garment Measurements (Inches)</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-4">
          <div class="table-responsive">
            <table class="table table-bordered text-center align-middle mb-0">
              <thead class="table-dark">
                <tr><th>Size</th><th>Bust</th><th>Waist</th><th>Hip</th></tr>
              </thead>
              <tbody>
                <% product.sizeChart.forEach(row => { %>
                  <tr>
                    <td class="fw-bold"><%= row.size %></td>
                    <td><%= row.bust %>"</td>
                    <td><%= row.waist %>"</td>
                    <td><%= row.hip %>"</td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <small class="text-muted d-block mt-3 text-center">Measured flat across garments. 1 inch tolerance.</small>
        </div>
      </div>
    </div>
  </div>
<% } %>

<script>
  function switchProductImage(src, thumbEl) {
    document.getElementById('mainProductImage').src = src;
    document.querySelectorAll('.detail-thumb').forEach(t => t.classList.remove('active'));
    thumbEl.classList.add('active');
  }

  function adjustQty(delta) {
    const el = document.getElementById('qtyInput');
    let val = parseInt(el.value, 10) || 1;
    val = Math.max(1, val + delta);
    el.value = val;
  }
</script>
