<!-- Luxury Hero Banner -->
<section class="hero-luxury py-5">
  <div class="container py-lg-4">
    <div class="row align-items-center g-4">
      <div class="col-12 col-lg-7">
        <span class="hero-badge">
          <i class="bi bi-stars me-1 text-gold"></i> Spring / Summer 2026 Capsule
        </span>
        <h1 class="hero-headline mb-3">
          Effortless Style, <br><span class="fst-italic text-gold" style="font-family: 'Playfair Display', serif;">Meticulous Poise.</span>
        </h1>
        <p class="lead text-light text-opacity-75 mb-4" style="max-width: 520px; font-size: 1.15rem; font-weight: 300;">
          Architectural silhouettes, breathable luxury fabrics, and versatile tailoring designed for the multifaceted woman.
        </p>
        <div class="d-flex flex-wrap gap-3">
          <a href="/shop" class="btn btn-primary-gold btn-lg px-4 py-3 rounded-pill">
            Explore Collection <i class="bi bi-arrow-right ms-2"></i>
          </a>
          <a href="/shop?category=dresses" class="btn btn-outline-light btn-lg px-4 py-3 rounded-pill">
            Shop Dresses
          </a>
        </div>
      </div>
      <div class="col-12 col-lg-5 d-none d-lg-block text-center position-relative">
        <div class="position-relative d-inline-block">
          <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?w=600&auto=format&fit=crop&q=80"
               class="rounded-4 shadow-lg border border-white border-opacity-10"
               style="width: 380px; height: 480px; object-fit: cover;"
               alt="Aurelle Lookbook">
          <!-- Floating Editorial Pill -->
          <div class="position-absolute bottom-0 start-0 translate-middle-y bg-white text-dark p-3 rounded-4 shadow-lg text-start ms-n3" style="max-width: 220px;">
            <div class="small text-muted text-uppercase tracking-wider" style="font-size:0.68rem;">Crafted Quality</div>
            <div class="fw-bold fs-6">100% Sustainable Natural Crepe</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Trust & Value Proposition Bar -->
<section class="trust-bar py-4">
  <div class="container">
    <div class="row g-3 text-center text-md-start">
      <div class="col-6 col-md-3">
        <div class="trust-item justify-content-center justify-content-md-start">
          <div class="trust-icon"><i class="bi bi-truck"></i></div>
          <div>
            <div class="fw-bold small text-dark">Complimentary Shipping</div>
            <div class="text-muted small" style="font-size:0.78rem;">On all orders over ₹1,999</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="trust-item justify-content-center justify-content-md-start">
          <div class="trust-icon"><i class="bi bi-arrow-counterclockwise"></i></div>
          <div>
            <div class="fw-bold small text-dark">Hassle-Free Returns</div>
            <div class="text-muted small" style="font-size:0.78rem;">7 days exchange guarantee</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="trust-item justify-content-center justify-content-md-start">
          <div class="trust-icon"><i class="bi bi-gem"></i></div>
          <div>
            <div class="fw-bold small text-dark">Artisanal Tailoring</div>
            <div class="text-muted small" style="font-size:0.78rem;">Premium breathable textiles</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="trust-item justify-content-center justify-content-md-start">
          <div class="trust-icon"><i class="bi bi-cash-stack"></i></div>
          <div>
            <div class="fw-bold small text-dark">Cash on Delivery</div>
            <div class="text-muted small" style="font-size:0.78rem;">Pay at your doorstep</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Shop by Curated Category -->
<section class="container py-5">
  <div class="text-center mb-5">
    <span class="text-uppercase text-gold fw-bold small tracking-wider">Curated Collections</span>
    <h2 class="display-6 fw-bold text-dark mt-1">Shop by Silhouette</h2>
    <p class="text-muted" style="max-width: 500px; margin: auto;">Pieces engineered for poise, comfort, and effortless day-to-night transitions.</p>
  </div>

  <div class="row g-4">
    <% categories.forEach(cat => { %>
      <div class="col-6 col-md-4 col-lg">
        <a href="/shop?category=<%= cat.slug %>" class="text-decoration-none">
          <div class="category-card">
            <div class="category-img-wrap">
              <img src="<%= cat.image %>" alt="<%= cat.name %>" loading="lazy">
              <div class="category-overlay">
                <h5 class="fw-bold mb-0 text-white"><%= cat.name %></h5>
                <small class="text-white-50"><%= cat.tagline %></small>
              </div>
            </div>
          </div>
        </a>
      </div>
    <% }) %>
  </div>
</section>

<!-- Featured Picks Section -->
<section class="container py-5">
  <div class="d-flex justify-content-between align-items-end mb-4">
    <div>
      <span class="text-uppercase text-gold fw-bold small tracking-wider">Editor's Choice</span>
      <h2 class="fw-bold text-dark mb-0">Featured Picks</h2>
    </div>
    <a href="/shop" class="btn btn-sm btn-outline-dark rounded-pill px-3 d-none d-md-inline-flex align-items-center gap-1">
      View All <i class="bi bi-arrow-right"></i>
    </a>
  </div>

  <div class="row g-4">
    <% featured.forEach(p => { %>
      <div class="col-6 col-md-4 col-lg-3">
        <%- include('partials/product-card', { p }) %>
      </div>
    <% }) %>
  </div>
</section>

<!-- Editorial Lookbook Banner -->
<section class="py-5 my-4 bg-dark text-white position-relative overflow-hidden">
  <div class="container py-4">
    <div class="row align-items-center g-5">
      <div class="col-12 col-lg-6">
        <span class="badge bg-gold-subtle text-gold text-uppercase mb-3 px-3 py-2 rounded-pill">Power Dressing Reimagined</span>
        <h2 class="display-5 fw-bold mb-3" style="font-family: 'Playfair Display', serif;">The Hustlease™ Capsule</h2>
        <p class="text-secondary lead mb-4">
          Say goodbye to stiff, uncomfortable office wear. Our Hustlease collection blends stretch crepes with sharp tailoring so you feel unstoppable from morning stands to celebratory cocktails.
        </p>
        <div class="d-flex gap-3">
          <a href="/shop?category=hustlease" class="btn btn-primary-gold rounded-pill px-4 py-2">
            Explore Hustlease <i class="bi bi-arrow-right ms-1"></i>
          </a>
        </div>
      </div>
      <div class="col-12 col-lg-6">
        <div class="row g-3">
          <div class="col-6">
            <img src="https://images.unsplash.com/photo-1487222477460-f4476524eaf8?w=600&auto=format&fit=crop&q=80" class="rounded-4 w-100 shadow" style="height: 280px; object-fit: cover;" alt="Capsule 1">
          </div>
          <div class="col-6">
            <img src="https://images.unsplash.com/photo-1509551388413-e18d0ac5d495?w=600&auto=format&fit=crop&q=80" class="rounded-4 w-100 shadow mt-4" style="height: 280px; object-fit: cover;" alt="Capsule 2">
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- New Arrivals Section -->
<section class="container py-5">
  <div class="d-flex justify-content-between align-items-end mb-4">
    <div>
      <span class="text-uppercase text-gold fw-bold small tracking-wider">Freshly Minted</span>
      <h2 class="fw-bold text-dark mb-0">New Arrivals</h2>
    </div>
    <a href="/shop" class="btn btn-sm btn-outline-dark rounded-pill px-3">
      Browse Shop <i class="bi bi-arrow-right"></i>
    </a>
  </div>

  <div class="row g-4">
    <% newArrivals.forEach(p => { %>
      <div class="col-6 col-md-4 col-lg-3">
        <%- include('partials/product-card', { p }) %>
      </div>
    <% }) %>
  </div>
</section>

