<div class="container-fluid p-0">
  <div class="row g-4">
    <!-- Left: Create Category Form -->
    <div class="col-12 col-lg-4">
      <div class="card border-0 shadow-sm sticky-top" style="top: 80px;">
        <div class="card-header bg-white border-0 pt-3 pb-0">
          <h6 class="fw-bold mb-0 text-dark">Add New Category</h6>
          <small class="text-muted">Create collections for storefront navigation</small>
        </div>
        <div class="card-body">
          <form action="/admin/categories" method="POST">
            <div class="mb-3">
              <label class="form-label fw-semibold">Category Name <span class="text-danger">*</span></label>
              <input type="text" name="name" class="form-control" placeholder="e.g. Evening Gowns" required>
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold">Tagline / Subtitle</label>
              <input type="text" name="tagline" class="form-control" placeholder="e.g. Crafted for memorable evenings.">
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold">Cover Image URL</label>
              <input type="text" name="image" class="form-control" placeholder="https://images.unsplash.com/...">
              <div class="form-text">Paste a high-resolution Unsplash or hosted image URL.</div>
            </div>
            <button type="submit" class="btn btn-primary-gold w-100 fw-bold">
              <i class="bi bi-plus-lg me-1"></i> Create Category
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- Right: Existing Categories List -->
    <div class="col-12 col-lg-8">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 pt-3 pb-2 d-flex justify-content-between align-items-center">
          <div>
            <h6 class="fw-bold mb-0 text-dark">Active Categories (<%= categories.length %>)</h6>
            <small class="text-muted">Collections mapped to products and navigation menus</small>
          </div>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th class="ps-3" style="width: 80px;">Cover</th>
                  <th>Category</th>
                  <th>Slug</th>
                  <th>Products</th>
                  <th class="text-end pe-3">Action</th>
                </tr>
              </thead>
              <tbody>
                <% if (categories && categories.length) { %>
                  <% categories.forEach(cat => { %>
                    <% const count = categoryCounts[cat._id] || 0; %>
                    <tr>
                      <td class="ps-3">
                        <img src="<%= cat.image || 'https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?w=800&auto=format&fit=crop&q=80' %>"
                             class="rounded shadow-sm"
                             style="width: 54px; height: 54px; object-fit: cover;"
                             alt="<%= cat.name %>">
                      </td>
                      <td>
                        <div class="fw-semibold text-dark"><%= cat.name %></div>
                        <small class="text-muted"><%= cat.tagline || 'No tagline set' %></small>
                      </td>
                      <td>
                        <span class="badge bg-light text-secondary font-monospace">/<%= cat.slug %></span>
                      </td>
                      <td>
                        <span class="badge bg-dark rounded-pill px-2 py-1"><%= count %> items</span>
                      </td>
                      <td class="text-end pe-3">
                        <div class="d-inline-flex gap-1">
                          <a href="/shop?category=<%= cat.slug %>" target="_blank" class="btn btn-sm btn-light border" title="View category in store">
                            <i class="bi bi-box-arrow-up-right"></i>
                          </a>
                          <form action="/admin/categories/<%= cat._id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this category?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger" <%= count > 0 ? 'title="Cannot delete while products are linked"' : '' %>>
                              <i class="bi bi-trash"></i>
                            </button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="5" class="text-center py-4 text-muted">No categories created yet.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
