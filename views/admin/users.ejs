<div class="container-fluid p-0">
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-0 pt-3 pb-2 d-flex justify-content-between align-items-center">
      <div>
        <h6 class="fw-bold mb-0 text-dark">Registered Users & Customers (<%= users.length %>)</h6>
        <small class="text-muted">Manage roles, review active accounts, and track customer engagement</small>
      </div>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-3">User</th>
              <th>Email</th>
              <th>Phone</th>
              <th>Orders Placed</th>
              <th>Role</th>
              <th>Registered</th>
              <th class="text-end pe-3">Modify Role</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(u => { %>
              <% const orderCount = userOrderCounts[u._id] || 0; %>
              <tr>
                <td class="ps-3">
                  <div class="d-flex align-items-center gap-2">
                    <div class="admin-avatar" style="width: 36px; height: 36px; font-size: 0.85rem;">
                      <%= u.name.charAt(0).toUpperCase() %>
                    </div>
                    <div>
                      <div class="fw-semibold text-dark"><%= u.name %></div>
                      <% if (u.role === 'admin') { %>
                        <span class="badge bg-gold-subtle text-gold" style="font-size:0.65rem;">ADMINISTRATOR</span>
                      <% } else { %>
                        <span class="badge bg-light text-secondary border" style="font-size:0.65rem;">CUSTOMER</span>
                      <% } %>
                    </div>
                  </div>
                </td>
                <td class="text-muted"><%= u.email %></td>
                <td class="text-muted small"><%= u.phone || '—' %></td>
                <td>
                  <span class="badge bg-light text-dark border">
                    <i class="bi bi-bag me-1"></i> <%= orderCount %> orders
                  </span>
                </td>
                <td>
                  <span class="badge <%= u.role === 'admin' ? 'bg-dark' : 'bg-secondary' %> rounded-pill">
                    <%= u.role %>
                  </span>
                </td>
                <td class="small text-muted">
                  <%= new Date(u.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                </td>
                <td class="text-end pe-3">
                  <form action="/admin/users/<%= u._id %>/role" method="POST" class="d-inline-flex gap-1 align-items-center">
                    <select name="role" class="form-select form-select-sm" style="width: 110px;">
                      <option value="customer" <%= u.role === 'customer' ? 'selected' : '' %>>Customer</option>
                      <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Admin</option>
                    </select>
                    <button type="submit" class="btn btn-sm btn-dark" title="Save Role">
                      <i class="bi bi-check-lg"></i>
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
