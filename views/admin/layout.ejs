<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | Aurelle Admin Control</title>
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap" rel="stylesheet">
  <!-- Bootstrap 5.3.3 & Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <!-- Chart.js for Admin Analytics -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
</head>
<body class="admin-body">
  <div class="admin-wrapper d-flex">
    
    <!-- Sidebar for Desktop & Offcanvas for Mobile -->
    <aside class="admin-sidebar" id="adminSidebar">
      <div class="admin-sidebar-header d-flex align-items-center justify-content-between p-3 border-bottom border-secondary border-opacity-25">
        <a href="/admin" class="d-flex align-items-center gap-2 text-decoration-none text-white">
          <span class="admin-logo-mark">A</span>
          <div>
            <div class="fw-bold tracking-wider fs-5 mb-0" style="font-family: 'Playfair Display', serif;">Aurelle</div>
            <span class="badge bg-gold-subtle text-gold text-uppercase" style="font-size: 0.65rem; letter-spacing: 1px;">Admin Console</span>
          </div>
        </a>
        <button class="btn btn-sm btn-outline-secondary d-lg-none" type="button" data-bs-dismiss="offcanvas" aria-label="Close" onclick="toggleAdminSidebar()">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>

      <div class="admin-sidebar-menu py-3">
        <div class="sidebar-category-label px-3 text-uppercase text-muted small fw-semibold mb-2" style="font-size:0.7rem; letter-spacing:1px;">Core Operations</div>
        <ul class="nav flex-column mb-3">
          <li class="nav-item">
            <a href="/admin" class="nav-link admin-nav-link <%= adminPath === '/' ? 'active' : '' %>">
              <i class="bi bi-grid-1x2 me-2"></i> Dashboard
            </a>
          </li>
          <li class="nav-item">
            <a href="/admin/products" class="nav-link admin-nav-link <%= adminPath && adminPath.startsWith('/products') && adminPath !== '/products/new' ? 'active' : '' %>">
              <i class="bi bi-handbag me-2"></i> Products
            </a>
          </li>
          <li class="nav-item">
            <a href="/admin/products/new" class="nav-link admin-nav-link <%= adminPath === '/products/new' ? 'active' : '' %>">
              <i class="bi bi-plus-circle me-2"></i> Add Product
            </a>
          </li>
          <li class="nav-item">
            <a href="/admin/categories" class="nav-link admin-nav-link <%= adminPath && adminPath.startsWith('/categories') ? 'active' : '' %>">
              <i class="bi bi-tags me-2"></i> Categories
            </a>
          </li>
          <li class="nav-item">
            <a href="/admin/orders" class="nav-link admin-nav-link <%= adminPath && adminPath.startsWith('/orders') ? 'active' : '' %>">
              <i class="bi bi-box-seam me-2"></i> Orders
            </a>
          </li>
          <li class="nav-item">
            <a href="/admin/users" class="nav-link admin-nav-link <%= adminPath && adminPath.startsWith('/users') ? 'active' : '' %>">
              <i class="bi bi-people me-2"></i> Customers & Users
            </a>
          </li>
        </ul>

        <div class="sidebar-category-label px-3 text-uppercase text-muted small fw-semibold mb-2" style="font-size:0.7rem; letter-spacing:1px;">Store Access</div>
        <ul class="nav flex-column mb-4">
          <li class="nav-item">
            <a href="/" target="_blank" class="nav-link admin-nav-link text-info">
              <i class="bi bi-box-arrow-up-right me-2"></i> View Live Store
            </a>
          </li>
          <li class="nav-item">
            <a href="/auth/logout" class="nav-link admin-nav-link text-danger">
              <i class="bi bi-box-arrow-right me-2"></i> Sign Out
            </a>
          </li>
        </ul>
      </div>

      <div class="admin-sidebar-footer p-3 border-top border-secondary border-opacity-25 mt-auto">
        <div class="d-flex align-items-center gap-2">
          <div class="admin-avatar">
            <%= (currentUser && currentUser.name) ? currentUser.name.charAt(0).toUpperCase() : 'A' %>
          </div>
          <div class="overflow-hidden">
            <div class="text-white text-truncate small fw-semibold"><%= currentUser ? currentUser.name : 'Administrator' %></div>
            <div class="text-muted" style="font-size: 0.72rem;">Super Admin</div>
          </div>
        </div>
      </div>
    </aside>

    <!-- Main Content wrapper -->
    <div class="admin-main-area flex-grow-1 d-flex flex-column min-vh-100">
      <!-- Admin Topbar -->
      <header class="admin-topbar sticky-top bg-white border-bottom px-4 py-2 d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-3">
          <button class="btn btn-sm btn-light border d-lg-none" type="button" onclick="toggleAdminSidebar()">
            <i class="bi bi-list fs-5"></i>
          </button>
          <div>
            <h5 class="mb-0 fw-bold text-dark"><%= title %></h5>
            <small class="text-muted d-none d-sm-inline">Aurelle E-Commerce Administration</small>
          </div>
        </div>

        <div class="d-flex align-items-center gap-3">
          <a href="/" class="btn btn-sm btn-outline-dark rounded-pill px-3 d-none d-md-inline-flex align-items-center gap-1">
            <i class="bi bi-shop"></i> Storefront
          </a>
          <a href="/admin/products/new" class="btn btn-sm btn-primary-gold rounded-pill px-3 d-inline-flex align-items-center gap-1">
            <i class="bi bi-plus-lg"></i> <span class="d-none d-sm-inline">Add Product</span>
          </a>
          <div class="dropdown">
            <button class="btn btn-sm btn-light border rounded-circle p-2" type="button" data-bs-toggle="dropdown">
              <i class="bi bi-person-circle fs-5"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0">
              <li><h6 class="dropdown-header"><%= currentUser ? currentUser.name : 'Admin' %></h6></li>
              <li><a class="dropdown-item" href="/"><i class="bi bi-shop me-2"></i> Visit Store</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item text-danger" href="/auth/logout"><i class="bi bi-box-arrow-right me-2"></i> Sign Out</a></li>
            </ul>
          </div>
        </div>
      </header>

      <!-- Flash alerts -->
      <div class="px-4 pt-3">
        <% if (success && success.length) { %>
          <% success.forEach(msg => { %>
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
              <i class="bi bi-check-circle-fill me-2"></i> <%= msg %>
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
          <% }) %>
        <% } %>
        <% if (error && error.length) { %>
          <% error.forEach(msg => { %>
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
              <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= msg %>
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
          <% }) %>
        <% } %>
      </div>

      <!-- Page Content -->
      <main class="admin-content-body flex-grow-1 px-4 py-3">
        <%- body %>
      </main>

      <footer class="admin-footer border-top bg-white px-4 py-3 text-center text-muted small">
        &copy; <%= new Date().getFullYear() %> Aurelle Fashion Group. Admin Management Suite.
      </footer>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function toggleAdminSidebar() {
      const sidebar = document.getElementById('adminSidebar');
      sidebar.classList.toggle('show');
    }
  </script>
</body>
</html>
