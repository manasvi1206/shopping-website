<div class="container-fluid p-0">
  <!-- Top Stat Cards -->
  <div class="row g-3 mb-4">
    <!-- Revenue -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card stat-card border-0 shadow-sm h-100">
        <div class="card-body d-flex align-items-center">
          <div class="stat-icon bg-success-subtle text-success me-3">
            <i class="bi bi-currency-rupee fs-4"></i>
          </div>
          <div>
            <div class="text-muted small fw-medium text-uppercase tracking-wider">Gross Sales</div>
            <h3 class="fw-bold mb-0 text-dark">₹<%= totalRevenue.toLocaleString('en-IN') %></h3>
            <span class="text-success small fw-semibold"><i class="bi bi-arrow-up-right"></i> Live Revenue</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Orders -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card stat-card border-0 shadow-sm h-100">
        <div class="card-body d-flex align-items-center">
          <div class="stat-icon bg-primary-subtle text-primary me-3">
            <i class="bi bi-bag-check fs-4"></i>
          </div>
          <div>
            <div class="text-muted small fw-medium text-uppercase tracking-wider">Total Orders</div>
            <h3 class="fw-bold mb-0 text-dark"><%= orderCount %></h3>
            <span class="text-primary small fw-semibold"><%= statusCounts.Placed %> pending fulfillment</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Products -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card stat-card border-0 shadow-sm h-100">
        <div class="card-body d-flex align-items-center">
          <div class="stat-icon bg-warning-subtle text-warning me-3">
            <i class="bi bi-tags fs-4"></i>
          </div>
          <div>
            <div class="text-muted small fw-medium text-uppercase tracking-wider">Catalog Items</div>
            <h3 class="fw-bold mb-0 text-dark"><%= productCount %></h3>
            <span class="text-muted small"><%= categoryCount %> Categories</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Customers -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card stat-card border-0 shadow-sm h-100">
        <div class="card-body d-flex align-items-center">
          <div class="stat-icon bg-info-subtle text-info me-3">
            <i class="bi bi-people fs-4"></i>
          </div>
          <div>
            <div class="text-muted small fw-medium text-uppercase tracking-wider">Total Customers</div>
            <h3 class="fw-bold mb-0 text-dark"><%= userCount %></h3>
            <% if (lowStockCount > 0) { %>
              <span class="text-danger small fw-semibold"><i class="bi bi-exclamation-circle"></i> <%= lowStockCount %> Low Stock</span>
            <% } else { %>
              <span class="text-success small fw-semibold"><i class="bi bi-check2"></i> Stock Healthy</span>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Analytics and Visual Breakdown -->
  <div class="row g-3 mb-4">
    <!-- Chart: Sales & Trend -->
    <div class="col-12 col-lg-8">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
          <div>
            <h6 class="fw-bold mb-0 text-dark">Revenue & Order Momentum</h6>
            <small class="text-muted">Visual analytics of recent commercial volume</small>
          </div>
          <span class="badge bg-light text-dark border">Quarterly Run</span>
        </div>
        <div class="card-body">
          <div style="height: 280px; position: relative;">
            <canvas id="salesChart"></canvas>
          </div>
        </div>
      </div>
    </div>

    <!-- Order Status Doughnut -->
    <div class="col-12 col-lg-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white border-0 pt-3 pb-0">
          <h6 class="fw-bold mb-0 text-dark">Order Fulfillment Status</h6>
          <small class="text-muted">Live pipeline metrics</small>
        </div>
        <div class="card-body d-flex flex-column justify-content-center">
          <div style="height: 200px; position: relative;">
            <canvas id="statusChart"></canvas>
          </div>
          <div class="d-flex justify-content-around text-center mt-3 pt-2 border-top">
            <div>
              <div class="small text-muted">Placed</div>
              <div class="fw-bold text-warning"><%= statusCounts.Placed %></div>
            </div>
            <div>
              <div class="small text-muted">Processing</div>
              <div class="fw-bold text-info"><%= statusCounts.Processing %></div>
            </div>
            <div>
              <div class="small text-muted">Delivered</div>
              <div class="fw-bold text-success"><%= statusCounts.Delivered %></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Orders & Quick Actions -->
  <div class="row g-3">
    <!-- Recent Orders Table -->
    <div class="col-12 col-xl-9">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 pt-3 pb-2 d-flex justify-content-between align-items-center">
          <div>
            <h6 class="fw-bold mb-0 text-dark">Recent Customer Orders</h6>
            <small class="text-muted">Latest purchases across the platform</small>
          </div>
          <a href="/admin/orders" class="btn btn-sm btn-outline-dark rounded-pill px-3">View All Orders</a>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th class="ps-3">Order ID</th>
                  <th>Customer</th>
                  <th>Items</th>
                  <th>Amount</th>
                  <th>Status</th>
                  <th>Date</th>
                  <th class="text-end pe-3">Action</th>
                </tr>
              </thead>
              <tbody>
                <% if (recentOrders && recentOrders.length) { %>
                  <% recentOrders.forEach(o => { %>
                    <tr>
                      <td class="ps-3 fw-bold font-monospace text-primary">#<%= o._id.toString().slice(-6).toUpperCase() %></td>
                      <td>
                        <div class="fw-semibold text-dark"><%= o.user ? o.user.name : 'Guest Customer' %></div>
                        <small class="text-muted"><%= o.user ? o.user.email : (o.shippingAddress ? o.shippingAddress.phone : 'N/A') %></small>
                      </td>
                      <td>
                        <span class="badge bg-light text-dark border">
                          <%= o.items.reduce((acc, i) => acc + i.quantity, 0) %> item(s)
                        </span>
                      </td>
                      <td class="fw-bold text-dark">₹<%= o.grandTotal.toLocaleString('en-IN') %></td>
                      <td>
                        <% let badgeClass = 'bg-secondary';
                           if (o.status === 'Placed') badgeClass = 'bg-warning text-dark';
                           else if (o.status === 'Processing') badgeClass = 'bg-info text-dark';
                           else if (o.status === 'Shipped') badgeClass = 'bg-primary text-white';
                           else if (o.status === 'Delivered') badgeClass = 'bg-success text-white';
                           else if (o.status === 'Cancelled') badgeClass = 'bg-danger text-white';
                        %>
                        <span class="badge <%= badgeClass %> rounded-pill px-2 py-1"><%= o.status %></span>
                      </td>
                      <td class="small text-muted"><%= new Date(o.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %></td>
                      <td class="text-end pe-3">
                        <a href="/admin/orders" class="btn btn-sm btn-light border rounded-pill">Manage</a>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="7" class="text-center py-4 text-muted">No orders found yet.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Shortcuts & Quick Stats -->
    <div class="col-12 col-xl-3">
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white border-0 pt-3 pb-0">
          <h6 class="fw-bold mb-0 text-dark">Quick Operations</h6>
        </div>
        <div class="card-body d-flex flex-column gap-2">
          <a href="/admin/products/new" class="btn btn-primary-gold w-100 d-flex align-items-center justify-content-center gap-2">
            <i class="bi bi-plus-circle"></i> Add New Product
          </a>
          <a href="/admin/categories" class="btn btn-outline-dark w-100 d-flex align-items-center justify-content-center gap-2">
            <i class="bi bi-folder-plus"></i> Manage Categories
          </a>
          <a href="/admin/orders" class="btn btn-light border w-100 d-flex align-items-center justify-content-center gap-2">
            <i class="bi bi-clock-history"></i> Review Orders
          </a>
          <a href="/admin/users" class="btn btn-light border w-100 d-flex align-items-center justify-content-center gap-2">
            <i class="bi bi-people"></i> Manage Customers
          </a>
        </div>
      </div>

      <!-- Quick Platform Health -->
      <div class="card border-0 shadow-sm bg-dark text-white p-3">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <span class="small text-uppercase text-secondary fw-semibold">Server & DB</span>
          <span class="badge bg-success">Operational</span>
        </div>
        <div class="d-flex align-items-center gap-2 small mb-1">
          <i class="bi bi-database-check text-success"></i> MongoDB Connected
        </div>
        <div class="d-flex align-items-center gap-2 small mb-1">
          <i class="bi bi-shield-check text-success"></i> Admin Session Active
        </div>
        <div class="d-flex align-items-center gap-2 small">
          <i class="bi bi-lightning-charge text-warning"></i> Express 4.19 / Node.js
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Sales Trend Chart
    const ctxSales = document.getElementById('salesChart');
    if (ctxSales) {
      new Chart(ctxSales, {
        type: 'line',
        data: {
          labels: ['May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct'],
          datasets: [{
            label: 'Sales (₹)',
            data: [12000, 19500, 24000, 31000, 28000, <%= totalRevenue > 0 ? totalRevenue : 35000 %>],
            borderColor: '#c5a880',
            backgroundColor: 'rgba(197, 168, 128, 0.15)',
            fill: true,
            tension: 0.4,
            pointRadius: 4,
            pointBackgroundColor: '#111827',
            pointBorderColor: '#c5a880',
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false }
          },
          scales: {
            y: {
              beginAtZero: true,
              grid: { color: 'rgba(0,0,0,0.05)' },
              ticks: {
                callback: function(val) { return '₹' + val.toLocaleString('en-IN'); }
              }
            },
            x: {
              grid: { display: false }
            }
          }
        }
      });
    }

    // Status Doughnut Chart
    const ctxStatus = document.getElementById('statusChart');
    if (ctxStatus) {
      new Chart(ctxStatus, {
        type: 'doughnut',
        data: {
          labels: ['Placed', 'Processing', 'Shipped', 'Delivered', 'Cancelled'],
          datasets: [{
            data: [
              <%= statusCounts.Placed %>,
              <%= statusCounts.Processing %>,
              <%= statusCounts.Shipped %>,
              <%= statusCounts.Delivered %>,
              <%= statusCounts.Cancelled %>
            ],
            backgroundColor: ['#f59e0b', '#06b6d4', '#3b82f6', '#10b981', '#ef4444'],
            borderWidth: 2,
            borderColor: '#ffffff'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false }
          },
          cutout: '70%'
        }
      });
    }
  });
</script>
