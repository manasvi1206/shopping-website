<div class="container-fluid p-0">
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
      <form method="GET" action="/admin/products" class="row g-2 align-items-center">
        <div class="col-12 col-md-5">
          <div class="input-group">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
            <input type="text" name="q" class="form-control border-start-0" placeholder="Search by product name..." value="<%= q %>">
          </div>
        </div>
        <div class="col-12 col-md-4">
          <select name="category" class="form-select" onchange="this.form.submit()">
            <option value="">All Categories</option>
            <% categories.forEach(cat => { %>
              <option value="<%= cat._id %>" <%= String(selectedCategory) === String(cat._id) ? 'selected' : '' %>>
                <%= cat.name %>
              </option>
            <% }) %>
          </select>
        </div>
        <div class="col-6 col-md-2">
          <button type="submit" class="btn btn-dark w-100">Filter</button>
        </div>
        <div class="col-6 col-md-1 text-end">
          <% if (q || selectedCategory) { %>
            <a href="/admin/products" class="btn btn-outline-secondary w-100" title="Reset Filters"><i class="bi bi-arrow-clockwise"></i></a>
          <% } %>
        </div>
      </form>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-0 pt-3 pb-2 d-flex justify-content-between align-items-center">
      <div>
        <h6 class="fw-bold mb-0 text-dark">Product Catalog (<%= products.length %>)</h6>
        <small class="text-muted">Manage items, stock counts, and merchandising flags</small>
      </div>
      <a href="/admin/products/new" class="btn btn-primary-gold btn-sm rounded-pill px-3">
        <i class="bi bi-plus-lg me-1"></i> Add Product
      </a>
    </div>

    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-3" style="width: 80px;">Image</th>
              <th>Product Details</th>
              <th>Category</th>
              <th>Pricing</th>
              <th>Stock Status</th>
              <th>Featured</th>
              <th class="text-end pe-3">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (products && products.length) { %>
              <% products.forEach(p => { %>
                <tr>
                  <td class="ps-3">
                    <img src="<%= p.images && p.images[0] ? p.images[0] : '/images/placeholder.png' %>"
                         class="rounded shadow-sm"
                         style="width: 52px; height: 52px; object-fit: cover;"
                         alt="<%= p.name %>">
                  </td>
                  <td>
                    <div class="fw-semibold text-dark"><%= p.name %></div>
                    <small class="text-muted font-monospace" style="font-size:0.75rem;"><%= p.slug %></small>
                  </td>
                  <td>
                    <span class="badge bg-light text-dark border">
                      <%= p.category ? p.category.name : 'Uncategorized' %>
                    </span>
                  </td>
                  <td>
                    <% if (p.salePrice) { %>
                      <div class="fw-bold text-dark">₹<%= p.salePrice.toLocaleString('en-IN') %></div>
                      <small class="text-muted text-decoration-line-through">₹<%= p.price.toLocaleString('en-IN') %></small>
                    <% } else { %>
                      <div class="fw-bold text-dark">₹<%= p.price.toLocaleString('en-IN') %></div>
                    <% } %>
                  </td>
                  <td>
                    <% if (p.stock <= 0) { %>
                      <span class="badge bg-danger">Out of stock (0)</span>
                    <% } else if (p.stock <= 10) { %>
                      <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle"></i> Low (<%= p.stock %>)</span>
                    <% } else { %>
                      <span class="badge bg-success-subtle text-success"><%= p.stock %> in stock</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (p.featured) { %>
                      <span class="badge bg-gold-subtle text-gold"><i class="bi bi-star-fill"></i> Featured</span>
                    <% } else { %>
                      <span class="text-muted small">—</span>
                    <% } %>
                  </td>
                  <td class="text-end pe-3">
                    <div class="d-inline-flex gap-1">
                      <a href="/product/<%= p.slug %>" target="_blank" class="btn btn-sm btn-light border" title="Preview on store">
                        <i class="bi bi-eye"></i>
                      </a>
                      <a href="/admin/products/<%= p._id %>/edit" class="btn btn-sm btn-outline-dark" title="Edit Product">
                        <i class="bi bi-pencil"></i>
                      </a>
                      <form action="/admin/products/<%= p._id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to permanently delete this product?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Product">
                          <i class="bi bi-trash"></i>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="7" class="text-center py-5 text-muted">
                  <i class="bi bi-search fs-1 d-block mb-2 text-secondary"></i>
                  No products match your search criteria.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
